includes:
  - phpstan-baseline.neon
  - ../.Build/vendor/bnf/phpstan-psr-container/extension.neon
  - ../.Build/vendor/phpstan/phpstan-phpunit/extension.neon

parameters:
  level: 8

  # Use local cache dir instead of /tmp
  tmpDir: ../.cache/phpstan

  paths:
    - ../Classes
    - ../Tests

  excludePaths:
    - ../Tests/Acceptance/*

  # inject*() methods of AbstractHealthCheck initialize its readonly properties, called once by DI.
  additionalConstructors:
    - Lolli\Dbdoctor\HealthCheck\AbstractHealthCheck::injectConnectionPool
    - Lolli\Dbdoctor\HealthCheck\AbstractHealthCheck::injectTcaHelper
    - Lolli\Dbdoctor\HealthCheck\AbstractHealthCheck::injectRecordsHelper
    - Lolli\Dbdoctor\HealthCheck\AbstractHealthCheck::injectTableHelper
    - Lolli\Dbdoctor\HealthCheck\AbstractHealthCheck::injectAffectedPagesRenderer
    - Lolli\Dbdoctor\HealthCheck\AbstractHealthCheck::injectRecordsRenderer
